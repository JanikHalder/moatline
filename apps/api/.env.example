NODE_ENV=development
DATABASE_URL=postgres://user:pass@localhost:5432/package_checker
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173
# Required to store integration secrets (Dokploy/Telegram/SMTP) encrypted at rest.
# Any passphrase works (hashed to a 32-byte key). e.g. openssl rand -base64 32
SECRETS_KEY=generate-with-openssl-rand-base64-32
# Required for private repo scans AND for the security auto-fix (PR create/merge + push).
GITHUB_TOKEN=optional-for-private-repos
# Set to true on exactly ONE api instance to run the scheduled-scan cron.
# Without it, a repo's scan schedule is saved but nothing ever runs it.
ENABLE_SCHEDULER=true

# Production: set NODE_ENV=production, use HTTPS URLs, CORS_ORIGIN required (comma-separated for multiple).
# See SECURITY.md for deployment checklist.
