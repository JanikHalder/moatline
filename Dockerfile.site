# The landing page and public docs (site/, VitePress) as a static site.
FROM node:20-alpine AS build
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@10.8.1 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY site/package.json site/
RUN pnpm install --frozen-lockfile --filter site...
COPY docs docs
COPY site site
# Analytics: Plausible on its own instance. Override as build arguments, or
# set PLAUSIBLE_DOMAIN to an empty value for none.
ARG PLAUSIBLE_DOMAIN="moatline.dev"
ARG PLAUSIBLE_SCRIPT="https://plausible.janikhalder.at/js/script.js"
RUN PLAUSIBLE_DOMAIN="$PLAUSIBLE_DOMAIN" PLAUSIBLE_SCRIPT="$PLAUSIBLE_SCRIPT" \
  pnpm --filter site build

FROM nginx:alpine
COPY --from=build /app/site/.vitepress/dist /usr/share/nginx/html
# Clean URLs (/guide/quick-start → quick-start.html).
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  location / { try_files $uri $uri.html $uri/ =404; }\n  error_page 404 /404.html;\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
